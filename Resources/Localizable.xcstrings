    "Relaunch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动"
          }
        }
      }
    },
    "Relaunch Claude Desktop?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重新启动 Claude Desktop 吗？"
          }
        }
      }
    },
    "Relaunch it in %@? Claude quits normally first; unsaved work in Claude may be affected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要以 %@ 重新启动吗？Claude 会先正常退出，未保存的内容可能会受影响。"
          }
        }
      }
    },
    "Relaunched Claude Desktop with TZ=%@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已以 TZ=%@ 重新启动 Claude Desktop。"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Removed env.TZ. Claude Code / URL Handler will use the system time zone after restart.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除 env.TZ。重启后 Claude Code 和 URL Handler 会使用系统时区。"
          }
        }
      }
    },
    "Removed the sandbox rules that hide the Mac's time zone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除隐藏 Mac 时区的 sandbox 规则。"
          }
        }
      }
    },
    "Restart CTimeZone to use the new language.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启 CTimeZone 后改用新语言。"
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重启"
          }
        }
      }
    },
    "Running in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正以 %@ 运行"
          }
        }
      }
    },
    "Running in %@ · relaunch for %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正以 %1$@ 运行 · 重启后改用 %2$@"
          }
        }
      }
    },
    "Running in system zone · relaunch for %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正以系统时区运行 · 重启后改用 %@"
          }
        }
      }
    },
    "Running, zone unreadable · target %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行，读不到时区 · 目标 %@"
          }
        }
      }
    },
    "Same time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间相同"
          }
        }
      }
    },
    "Saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存"
          }
        }
      }
    },
    "Saved env.TZ=%@ for Claude Code and URL Handler. Restart those sessions to apply.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 Claude Code 和 URL Handler 保存 env.TZ=%@，重启这些会话后生效。"
          }
        }
      }
    },
    "Select a time zone first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择一个时区。"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中显示"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统"
          }
        }
      }
    },
    "System (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统（%@）"
          }
        }
      }
    },
    "System time zone could not be resolved; cannot build a launch environment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定系统时区，没法生成启动环境。"
          }
        }
      }
    },
    "The Dock launcher follows this setting too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 启动器也会跟着改用这个语言。"
          }
        }
      }
    },
    "This Mac · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac · %@"
          }
        }
      }
    },
    "This build has no update signing key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本没有更新签名密钥。"
          }
        }
      }
    },
    "Time zone unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定时区"
          }
        }
      }
    },
    "Turns on Claude Code's sandbox and denies reads of /etc/localtime and the global preferences. If the sandbox was off with no settings of your own, it also allows writes anywhere, all network domains, Unix sockets and local ports; otherwise your sandbox settings stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Claude Code 的 sandbox，并禁止读取 /etc/localtime 和全局偏好设置。如果 sandbox 原来是关的，也没有你自己的设置，会一并放开写入、所有网络域名、Unix socket 和本地端口；否则保留你原有的 sandbox 设置。"
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知"
          }
        }
      }
    },
