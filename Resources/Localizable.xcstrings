      }
    },
    "Launch failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动失败：%@"
          }
        }
      }
    },
    "Launched Claude Desktop with TZ=%@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已以 TZ=%@ 启动 Claude Desktop。"
          }
        }
      }
    },
    "Move CTimeZone to Applications to enable updates.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 CTimeZone 移到「应用程序」文件夹后才能自动更新。"
          }
        }
      }
    },
    "Moved the launcher to the Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已把启动器移到废纸篓。"
          }
        }
      }
    },
    "Not a valid IANA time zone: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是有效的 IANA 时区：%@"
