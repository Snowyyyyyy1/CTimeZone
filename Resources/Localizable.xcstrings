      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用系统时区"
          }
        }
      }
    },
    "World map showing day and night, with the Mac and Claude time zones marked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示昼夜分布的世界地图，标出了 Mac 和 Claude 的时区"
          }
        }
      }
    },
